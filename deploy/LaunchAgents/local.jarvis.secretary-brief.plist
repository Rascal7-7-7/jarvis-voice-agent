<?xml version="1.0" encoding="UTF-8"?>
<!--
  秘書の定時ブリーフィング。平日 09:00 に secretary brief をファイルへ落とし通知する。

  未登録の状態で配布している。有効化は明示的に:
    cp ~/AI-Lab/deploy/LaunchAgents/local.jarvis.secretary-brief.plist ~/Library/LaunchAgents/
    launchctl bootstrap gui/$(id -u) ~/Library/LaunchAgents/local.jarvis.secretary-brief.plist
  停止:
    launchctl bootout gui/$(id -u)/local.jarvis.secretary-brief

  RunAtLoad は付けない。ログイン直後は負荷が高く（実測 load average 290）、
  ブリーフィングを走らせる時刻ではない。
-->
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>local.jarvis.secretary-brief</string>

  <key>ProgramArguments</key>
  <array>
    <string>/Users/Rascal/work/scripts/secretary/brief-cron.sh</string>
  </array>

  <key>StartCalendarInterval</key>
  <array>
    <dict><key>Weekday</key><integer>1</integer><key>Hour</key><integer>9</integer><key>Minute</key><integer>0</integer></dict>
    <dict><key>Weekday</key><integer>2</integer><key>Hour</key><integer>9</integer><key>Minute</key><integer>0</integer></dict>
    <dict><key>Weekday</key><integer>3</integer><key>Hour</key><integer>9</integer><key>Minute</key><integer>0</integer></dict>
    <dict><key>Weekday</key><integer>4</integer><key>Hour</key><integer>9</integer><key>Minute</key><integer>0</integer></dict>
    <dict><key>Weekday</key><integer>5</integer><key>Hour</key><integer>9</integer><key>Minute</key><integer>0</integer></dict>
  </array>

  <key>StandardOutPath</key>
  <string>/Users/Rascal/work/scripts/secretary/briefs/cron.out.log</string>
  <key>StandardErrorPath</key>
  <string>/Users/Rascal/work/scripts/secretary/briefs/cron.error.log</string>

  <key>ProcessType</key>
  <string>Background</string>
</dict>
</plist>

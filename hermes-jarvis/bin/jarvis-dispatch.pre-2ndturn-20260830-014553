#!/bin/zsh
# jarvis-dispatch — one utterance in, one voice-sized answer out.
#
#   utterance
#     -> jarvis_router (deterministic gate -> override -> fast path -> LLM)
#     -> LOCAL  : Hermes local brain
#        WEB    : Hermes + web tools
#        CODEX  : jarvis-codex   (read-only sandbox, hard timeout)
#        CLAUDE : jarvis-claude  (plan mode, config-root verified)
#        CONFIRMATION_REQUIRED : STOP. Ask the human. Never dispatch.
#
# C8: the reply is kept short enough to speak. Codex/Claude raw output is NOT
# read aloud verbatim — it is summarised to a conclusion plus an offer to read
# the detail, because a HUD will carry the detail later.

set -u
emulate -L zsh

BIN="${0:A:h}"
PY="$HOME/.hermes-venv/bin/python"
WORKDIR="${JARVIS_WORKDIR:-$HOME/AI-Lab/hermes-jarvis/fixtures/codex-readonly}"

[[ $# -ge 1 ]] || { print -u2 "usage: jarvis-dispatch <utterance>"; exit 64 }
UTTERANCE="$*"

# The runtime has already gated and routed this utterance, so it passes the
# verdict down rather than paying for the whole router a second time in a
# second process (measured 2.3-3.9 s warm, 17.67 s cold). Run standalone -- by
# hand, or from anything that does not set JARVIS_ROUTE -- it still routes for
# itself, so this stays a self-contained command.
#
# Not a trust boundary. CONFIRMATION_REQUIRED is still refused below, and an
# inherited route can only name one of the labels the router itself produces.
if [[ -n "${JARVIS_ROUTE:-}" ]]; then
  route="$JARVIS_ROUTE"
  by="${JARVIS_ROUTE_BY:-inherited}"
  cats="${JARVIS_ROUTE_CATS:-}"
else
  decision=$("$PY" "$BIN/jarvis_router.py" "$UTTERANCE") || {
    print -u2 "jarvis-dispatch: router failed"; exit 70
  }
  # One interpreter, three values -- it used to be three interpreters.
  eval "$("$PY" -c '
import json, shlex, sys
d = json.loads(sys.stdin.read())
print("route=" + shlex.quote(d["route"]))
print("by=" + shlex.quote(d["decided_by"]))
print("cats=" + shlex.quote(",".join(d.get("categories") or [])))
' <<< "$decision")"
fi

print -u2 "[route=$route by=$by${cats:+ categories=$cats}]"

case "$route" in
  CONFIRMATION_REQUIRED)
    # Deliberately produces SPEECH ONLY. No tool, no delegation, no execution.
    print "その操作は取り消せない可能性があります（${cats}）。実行してよろしいですか？"
    exit 0
    ;;
  CODEX)
    out=$("$BIN/jarvis-codex" "$WORKDIR" "$UTTERANCE 日本語で簡潔に。" 2>/dev/null) || {
      print "Codexを利用できませんでした。"; exit 0
    }
    ;;
  CLAUDE)
    out=$("$BIN/jarvis-claude" "$WORKDIR" "$UTTERANCE 日本語で簡潔に。" 2>/dev/null) || {
      print "Claudeを利用できませんでした。"; exit 0
    }
    ;;
  LOCAL_FAST)
    # No agent, no tools, ~722 B of system prompt. Answers stable knowledge and
    # greetings only; anything needing the world right now comes back NEED_TOOL
    # and falls through to LOCAL_TOOL below, silently -- the user hears an
    # answer, never a routing failure.
    # One interpreter, and the answer comes back as plain text rather than as
    # JSON: passing JSON back through zsh meant brace-expanding "{...}", which
    # silently turned every verdict into NEED_TOOL.
    fast=$("$PY" -c '
import sys
sys.path.insert(0, sys.argv[1])
import jarvis_local_fast as f
r = f.ask(sys.argv[2])
if r["status"] == "ANSWER" and r["answer"]:
    sys.stdout.write(r["answer"])
    sys.exit(0)
sys.stderr.write("need_tool reason=%s\n" % (r.get("demoted") or "model"))
sys.exit(3)
' "$BIN" "$UTTERANCE")
    if [[ $? -eq 0 && -n "${fast//[[:space:]]/}" ]]; then
      print -r -- "$fast"
      exit 0
    fi
    print -u2 "[local_fast=NEED_TOOL -> LOCAL_TOOL]"
    route=LOCAL_TOOL
    ;&        # zsh fallthrough: continue into the LOCAL_TOOL branch
  LOCAL_TOOL|WEB|LOCAL)
    # Same agent, same approvals, same system prompt -- only the toolset is
    # narrowed to what this utterance actually needs.
    if [[ "$route" == "WEB" ]]; then
      tsets="web,file,clarify"; profile="WEB"
    else
      profile=$("$PY" -c '
import sys
sys.path.insert(0, sys.argv[1])
import jarvis_profiles as p
print(p.select(sys.argv[2]))
' "$BIN" "$UTTERANCE")
      tsets=$("$PY" -c '
import sys
sys.path.insert(0, sys.argv[1])
import jarvis_profiles as p
print(p.toolsets_arg(sys.argv[2]))
' "$BIN" "$profile")
    fi
    print -u2 "[profile=$profile toolsets='${tsets}']"
    out=$(cd "$WORKDIR" && "$HOME/.local/bin/hermes" -t "$tsets" -z "$UTTERANCE" 2>/dev/null) || {
      print "ローカルで応答できませんでした。"; exit 0
    }
    # An unknown toolset makes hermes exit 0 with an empty answer (measured:
    # 0.56 s of silence). Treat empty as failure rather than speaking nothing.
    if [[ -z "${out//[[:space:]]/}" ]]; then
      print -u2 "[empty answer with toolsets='${tsets}' -- retrying with the full agent]"
      out=$(cd "$WORKDIR" && "$HOME/.local/bin/hermes" -z "$UTTERANCE" 2>/dev/null)
    fi
    print -r -- "${out:-うまく応答できませんでした。}"
    exit 0
    ;;
  *)
    print "うまく判断できませんでした。もう一度お願いします。"
    exit 0
    ;;
esac

# ---- C8: shrink a delegated answer to something speakable -------------------
"$PY" - "$route" <<PYEOF
import json, sys, urllib.request
route = sys.argv[1]
detail = """$out"""
body = {
    "model": "gemma4:e2b",
    "messages": [
        {"role": "system", "content":
         "あなたはJarvis。渡された調査結果を、音声で読み上げる用に日本語2文以内へ要約します。"
         "結論を先に言い、箇条書き・記号・コードは使いません。"
         "最後に「詳細も読み上げますか？」と付け加えます。"},
        {"role": "user", "content": detail[:4000]},
    ],
    "max_tokens": 220, "temperature": 0, "reasoning_effort": "none",
}
req = urllib.request.Request("http://127.0.0.1:11434/v1/chat/completions",
                             data=json.dumps(body).encode(),
                             headers={"Content-Type": "application/json"})
try:
    d = json.load(urllib.request.urlopen(req, timeout=30))
    said = (d["choices"][0]["message"].get("content") or "").strip()
except Exception:
    said = ""
print(said or (detail.strip().splitlines() or ["結果を取得しました。"])[0][:160])
print(f"\n--- {route} full output ({len(detail)} chars) kept for the HUD ---", file=sys.stderr)
PYEOF
